APP_NAME=Familywell
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Receipt scanning (optional). Get a free key at https://aistudio.google.com/apikey.
# When set, spends gain a "Scan receipt" action that auto-fills the form from a photo
# (~$0.001 per scan). Leave blank to hide the feature entirely.
GEMINI_API_KEY=

# AI categorisation (optional). Get a key at https://typesafe.ai.
# When set, shopping items added into "Other" are sorted into the shop's best-fit
# aisle right after saving, and Spending settings can bulk-sort "Other" expenses.
TYPESAFE_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# Stripe paywall (hosted familywell.co only). Leave STRIPE_KEY empty to disable the paywall entirely.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Intro offer (config/familywell.php pricing): the first PRICING_INTRO_SPOTS families pay the intro amounts
# on the two prices above; after that checkout uses the _STANDARD prices. Amounts must match Stripe.
STRIPE_PRICE_MONTHLY_STANDARD=
STRIPE_PRICE_YEARLY_STANDARD=
PRICING_INTRO_SPOTS=100
PRICING_INTRO_MONTHLY=5
PRICING_INTRO_YEARLY=45
PRICING_MONTHLY=6
PRICING_YEARLY=54

# Umami analytics (hosted familywell.co only). Leave empty to load no tracker. Production uses the website
# familywell.org shares (docs/analytics.md): b42f8cb0-3c6b-4e52-9e72-ba81ee80dd88.
UMAMI_WEBSITE_ID=
# Server-side events (sign-ups, billing, assistant use) are posted here; defaults to the script's Umami.
# UMAMI_HOST=https://analytics.dragonpie.co

# Sign in with Google (optional). OAuth "Web application" client from Google Cloud Console; add
# ${APP_URL}/auth/google/callback as an authorized redirect URI. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional). APPLE_CLIENT_ID is the Services ID, with ${APP_URL}/auth/apple/callback
# as its return URL (Apple rejects localhost). APPLE_PRIVATE_KEY is the .p8 key's PEM contents, on one
# line with \n escapes. Leave any of them empty to hide the button.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
